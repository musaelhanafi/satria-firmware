# Default parameters for fmuv3-hil-elevon (SITL-on-hardware with X-Plane backend)
# Flying-wing elevon: CH1=left elevon (ElevonLeft), CH2=right elevon (ElevonRight), CH3=throttle.
# X-Plane provides physics; SITL sensor backends read from SIMState which
# is populated by the XPlane UDP data stream.

# ── EKF ──────────────────────────────────────────────────────────────────────
# EKF3 disabled — gyro not updating with EKF3 on fmuv3 (STM32F427).
# EKF2 is stable with SITL XPlane backend on this board.
AHRS_EKF_TYPE 2
EK2_ENABLE 1
EK3_ENABLE 0

# Compass: enabled — SITL compass backend reads from SIMState
COMPASS_USE 1

# GPS: SITL GPS backend (type 100)
GPS1_TYPE 100

# Airspeed: SITL backend
ARSPD_TYPE 100

# Safety: no safety switch needed in simulation
BRD_SAFETY_DEFLT 0

# Arming: skip all pre-arm checks for simulation (-1 = skip all)
ARMING_SKIPCHK -1
ARMING_REQUIRE 1

# RC: disable throttle failsafe and RC override timeout
THR_FAILSAFE 0
RC_OVERRIDE_TIME -1

# Scheduler: 50 Hz — prevents watchdog reset on STM32F427
SCHED_LOOP_RATE 50

# Logging: disabled — no SD card
LOG_BITMASK 0
LOG_BACKEND_TYPE 0
LOG_DISARM 0

# SITL speedup: 1x real-time
SIM_SPEEDUP 1

# ── Servo output functions — flying-wing elevon ───────────────────────────────
# ArduPlane pre-mixes aileron + elevator into elevon outputs:
#   ElevonLeft  (77): elevator + aileron → CH1 → wing1l_ail1def
#   ElevonRight (78): elevator - aileron → CH2 → wing1r_ail1def (inverted in JSON)
SERVO1_FUNCTION 77   # ElevonLeft
SERVO2_FUNCTION 78   # ElevonRight
SERVO3_FUNCTION 70   # Throttle

# ── RC input channel mapping ──────────────────────────────────────────────────
RCMAP_ROLL      1
RCMAP_PITCH     2
RCMAP_THROTTLE  3
RCMAP_YAW       4

# ── Auto takeoff ──────────────────────────────────────────────────────────────
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_DELAY  0
TKOFF_THR_MAX    100
TKOFF_ROTATE_SPD 12
GROUND_STEER_ALT 0
TKOFF_TDRAG_ELEV 0
TKOFF_TDRAG_SPD1 0

# ── SITL servo override ───────────────────────────────────────────────────────
SIM_OH_MASK 255

# ── X-Plane UDP bind port ────────────────────────────────────────────────────
# X-Plane → Settings → Net Connections → Data: send DATA@ to 10.0.0.2:49005
SIM_XP_BIND_PORT 49005

# ── SITL home position — Bandung WICC ────────────────────────────────────────
SIM_OPOS_LAT -6.897434
SIM_OPOS_LNG  107.566887
SIM_OPOS_ALT  744.0
SIM_OPOS_HDG  108.0

# ── Tracking target position ──────────────────────────────────────────────────
TRK_TGT_LAT -6.897367724
TRK_TGT_LON  107.566559898
TRK_TGT_ALT 744

# ── Networking / PPP ─────────────────────────────────────────────────────────
# USB (SERIAL0) stays as MAVLink2 — QGC connects directly via USB.
# PPP runs on TELEM2 (SERIAL2) for X-Plane UDP data.
# PC command (macOS): sudo pppd /dev/tty.usbserial-XXXX 115200 10.0.0.1:10.0.0.2 noauth local nodetach asyncmap 0 novj nopcomp noaccomp lcp-echo-interval 0
# PC command (Linux): sudo pppd /dev/ttyUSB0 115200 10.0.0.1:10.0.0.2 noauth local nodetach asyncmap 0 novj nopcomp noaccomp lcp-echo-interval 0
SERIAL0_PROTOCOL 2
SERIAL0_BAUD 921

NET_ENABLE 1
SERIAL2_PROTOCOL 48
SERIAL2_BAUD 115

NET_IPADDR0 10
NET_IPADDR1 0
NET_IPADDR2 0
NET_IPADDR3 2

# NET_OPTIONS bit 6 (64) = PPP_ECHO_LIMIT_DISABLE
NET_OPTIONS 64
TRK_APP_SPD 0
TRK_CLOSE_M 1000
TRK_DBAND 0.25
TRK_MAX_DEG 30
TRK_PITCH_OFFSET 7
TRK_PTCH_D 0
TRK_PTCH_D_FF 0
TRK_PTCH_FF 0
TRK_PTCH_FLTD 20
TRK_PTCH_FLTE 4
TRK_PTCH_FLTT 0
TRK_PTCH_I 50
TRK_PTCH_IMAX 1000
TRK_PTCH_NEF 0
TRK_PTCH_NTF 0
TRK_PTCH_P 45
TRK_PTCH_PDMX 0
TRK_PTCH_SMAX 0
TRK_ROLL_D 0
TRK_ROLL_D_FF 0
TRK_ROLL_FF 0
TRK_ROLL_FLTD 20
TRK_ROLL_FLTE 0
TRK_ROLL_FLTT 0
TRK_ROLL_I 50
TRK_ROLL_IMAX 500
TRK_ROLL_NEF 0
TRK_ROLL_NTF 0
TRK_ROLL_P 50
TRK_ROLL_PDMX 0
TRK_ROLL_SMAX 0
TRK_SETTLE_S 2
TRK_THR_D 1
TRK_THR_D_FF 0
TRK_THR_FF 0
TRK_THR_FLTD 20
TRK_THR_FLTE 0
TRK_THR_FLTT 0
TRK_THR_I 5
TRK_THR_IMAX 50
TRK_THR_NEF 0
TRK_THR_NTF 0
TRK_THR_P 5
TRK_THR_PDMX 0
TRK_THR_SMAX 0
TRK_TIMEOUT 1000
