# Default parameters for x86-hil-vtail-vtol (SITL-on-laptop with X-Plane backend)
# Target: x86 PC / laptop running ArduPlane (QuadPlane) as SITL binary.
# V-tail QuadPlane: 4 H-frame quad lift motors (CH5-CH8) + V-tail surfaces (CH1-CH4).
# X-Plane model requires 5 engines (engine[0-3] = quad, engine[4] = forward pusher).
#
# Build:  ./waf configure --board x86-hil-vtail-vtol && ./waf plane
# Run:    sim_vehicle.py -v ArduPlane --model xplane --map --console

# ── AHRS / attitude source ────────────────────────────────────────────────────
# AHRS_EKF_TYPE 10 = SIM backend: attitude read directly from X-Plane quaternion.
AHRS_EKF_TYPE 10
EK3_ENABLE 1
EK2_ENABLE 0

# ── Sensors — SITL backends ──────────────────────────────────────────────────
GPS1_TYPE 100
ARSPD_TYPE 100

# ── Compass — keep only one SITL instance ────────────────────────────────────
COMPASS_USE  1
COMPASS_USE2 0
COMPASS_USE3 0
SIM_MAG2_DEVID 0
SIM_MAG3_DEVID 0

# ── Safety / arming ───────────────────────────────────────────────────────────
BRD_SAFETY_DEFLT 0
ARMING_SKIPCHK  -1
ARMING_REQUIRE   1

# ── RC ───────────────────────────────────────────────────────────────────────
THR_FAILSAFE     0
RC_OVERRIDE_TIME -1

# ── Servo output functions ────────────────────────────────────────────────────
# Fixed-wing surfaces (CH1-CH4)
SERVO1_FUNCTION 4    # Aileron
SERVO2_FUNCTION  80  # Vtail_right  (elevator - rudder) * MIXING_GAIN
SERVO2_REVERSED  1
SERVO3_FUNCTION  70  # Throttle     forward pusher motor → engine[4]
SERVO4_FUNCTION  79  # Vtail_left   (elevator + rudder) * MIXING_GAIN
SERVO4_REVERSED  1

# Quad lift motors (CH5-CH8) — H-frame
SERVO5_FUNCTION 33   # Motor1  front-right  CW
SERVO6_FUNCTION 34   # Motor2  rear-left    CW
SERVO7_FUNCTION 35   # Motor3  front-left  CCW
SERVO8_FUNCTION 36   # Motor4  rear-right  CCW

# ── V-tail mixing ─────────────────────────────────────────────────────────────
# MIXING_GAIN 1.0: full servo travel for full stick input.
# xplane_vtail_vtol.json maps CH2/CH4 directly to vstab surface datarefs.
MIXING_GAIN 1.0

# ── RC input channel mapping ──────────────────────────────────────────────────
RCMAP_ROLL      1
RCMAP_PITCH     2
RCMAP_THROTTLE  3
RCMAP_YAW       4

# ── QuadPlane ─────────────────────────────────────────────────────────────────
Q_ENABLE      1
Q_FRAME_CLASS 1   # Quad
Q_FRAME_TYPE  3   # H-frame

# Motor settings
Q_M_PWM_TYPE   0
Q_M_SPIN_ARM   0.10
Q_M_SPIN_MIN   0.15
Q_M_THST_EXPO  0.65

# Transition: descend to QHOVER below this airspeed (m/s)
Q_ASSIST_SPEED 12

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHED_LOOP_RATE 50

# ── INS filters ──────────────────────────────────────────────────────────────
INS_GYRO_FILTER  20
INS_ACCEL_FILTER 20

# ── Roll rate controller ──────────────────────────────────────────────────────
RLL_RATE_P       0.08
RLL_RATE_I       0.15
RLL_RATE_D       0
RLL_RATE_FF      0.345
RLL_RATE_FLTD    12
RLL_RATE_IMAX    0.666
RLL2SRV_TCONST   0.5
RLL2SRV_RMAX     0

# ── Pitch rate controller ─────────────────────────────────────────────────────
PTCH_RATE_P      0.04
PTCH_RATE_I      0.15
PTCH_RATE_D      0
PTCH_RATE_FF     0.345
PTCH_RATE_FLTD   12
PTCH_RATE_IMAX   0.666
PTCH2SRV_TCONST  0.5
PTCH2SRV_RMAX_UP 0
PTCH2SRV_RMAX_DN 0
PTCH2SRV_RLL     1

# ── Flight envelope ───────────────────────────────────────────────────────────
AIRSPEED_CRUISE   12
AIRSPEED_MIN       9
AIRSPEED_MAX      22
TRIM_THROTTLE     45
PTCH_LIM_MIN_DEG -25
PTCH_LIM_MAX_DEG  20
ROLL_LIMIT_DEG    45

# ── Navigation ────────────────────────────────────────────────────────────────
NAVL1_PERIOD   17
NAVL1_DAMPING  0.75
KFF_RDDRMIX    0.5

# ── RC input channel mapping ──────────────────────────────────────────────────
RCMAP_ROLL      1
RCMAP_PITCH     2
RCMAP_THROTTLE  3
RCMAP_YAW       4

# ── SITL speedup ─────────────────────────────────────────────────────────────
SIM_SPEEDUP 1

# ── SITL servo override ───────────────────────────────────────────────────────
SIM_OH_MASK 0

# ── SITL home position — Bandung WICC ─────────────────────────────────────────
SIM_OPOS_LAT -6.897434
SIM_OPOS_LNG  107.566887
SIM_OPOS_ALT  744.0
SIM_OPOS_HDG  108.0

# ── Tracking target position ──────────────────────────────────────────────────
TRK_TGT_LAT -6.897367724
TRK_TGT_LON  107.566559898
TRK_TGT_ALT  744.0

# ── Default flight modes ──────────────────────────────────────────────────────
# QHOVER (18) for hover, FBWA (5) for fixed-wing cruise, AUTO (10) for mission.
FLTMODE1 18   # QHOVER
FLTMODE2 18   # QHOVER
FLTMODE3  5   # FBWA
FLTMODE4 19   # QLOITER
FLTMODE5 10   # AUTO
FLTMODE6 18   # QHOVER

# ── Auto takeoff ──────────────────────────────────────────────────────────────
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_DELAY  0
TKOFF_THR_MAX    100
