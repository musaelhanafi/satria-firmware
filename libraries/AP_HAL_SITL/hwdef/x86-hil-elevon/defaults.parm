# Default parameters for x86-hil-elevon (SITL-on-laptop with X-Plane backend)
# Target machine: x86 PC / laptop running ArduPlane as SITL binary.
# Flying-wing elevon: CH1=left elevon (ElevonLeft), CH2=right elevon (ElevonRight), CH3=throttle.
#
# Build:  ./waf configure --board x86-hil-elevon && ./waf plane
# Run:    sim_vehicle.py -v ArduPlane --model xplane --map --console
#
# Differences from fmuv3-hil-elevon:
#   - EKF type 10 (SIM backend, direct X-Plane quaternion — zero heading lag)
#   - No SCHED_LOOP_RATE cap (x86 scheduler handles 400 Hz)
#   - Logging enabled to disk
#   - No PPP/NET setup (SITL XPlane backend uses direct UDP sockets)

# ── Servo output functions — flying-wing elevon ───────────────────────────────
# ArduPlane pre-mixes aileron + elevator into elevon outputs:
#   ElevonLeft  (77): elevator + aileron
#   ElevonRight (78): elevator - aileron
# xplane_elevon.json maps CH1 → wing1l and CH2 → wing1r (inverted) directly.
SERVO1_FUNCTION 77   # ElevonLeft
SERVO2_FUNCTION 78   # ElevonRight
SERVO3_FUNCTION 70   # Throttle

# ── AHRS / attitude source ────────────────────────────────────────────────────
AHRS_EKF_TYPE 10
EK3_ENABLE 1
EK2_ENABLE 0

# ── Sensors — SITL backends ──────────────────────────────────────────────────
GPS1_TYPE 100
ARSPD_TYPE 100

# ── Compass — keep only one SITL instance ────────────────────────────────────
COMPASS_USE  1
COMPASS_USE2 0
COMPASS_USE3 0
SIM_MAG2_DEVID 0
SIM_MAG3_DEVID 0

# ── Safety / arming ───────────────────────────────────────────────────────────
BRD_SAFETY_DEFLT 0
ARMING_SKIPCHK -1
ARMING_REQUIRE 1

# ── RC ───────────────────────────────────────────────────────────────────────
THR_FAILSAFE 0
RC_OVERRIDE_TIME -1

# ── RC input channel mapping ──────────────────────────────────────────────────
RCMAP_ROLL      1
RCMAP_PITCH     2
RCMAP_THROTTLE  3
RCMAP_YAW       4

# ── SITL speedup ─────────────────────────────────────────────────────────────
SIM_SPEEDUP 1

# ── Auto takeoff ──────────────────────────────────────────────────────────────
# Flying wings typically hand-launch; TKOFF_THR_MINACC=0 applies throttle
# immediately. TKOFF_ROTATE_SPD triggers pitch-up at this airspeed (m/s).
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_DELAY 0
TKOFF_THR_MAX 100
TKOFF_ROTATE_SPD 12
GROUND_STEER_ALT 0
TKOFF_TDRAG_ELEV 0
TKOFF_TDRAG_SPD1 0

# ── SITL servo override ───────────────────────────────────────────────────────
SIM_OH_MASK 255

# ── SITL home position — Bandung WICC ─────────────────────────────────────────
SIM_OPOS_LAT -6.897434
SIM_OPOS_LNG  107.566887
SIM_OPOS_ALT  744.0
SIM_OPOS_HDG  108.0

# ── Tracking target position ──────────────────────────────────────────────────
TRK_TGT_LAT -6.897367724
TRK_TGT_LON  107.566559898
TRK_TGT_ALT  744.0

# ── Networking ────────────────────────────────────────────────────────────────
# On x86/SITL the XPlane backend uses direct UDP sockets — no PPP needed.
