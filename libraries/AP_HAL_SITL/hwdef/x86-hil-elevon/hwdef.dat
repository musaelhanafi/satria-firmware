# x86-hil-elevon: SITL board for HIL with X-Plane on x86/laptop — flying-wing elevon airframe.
# Inherits the base SITL HAL; builds natively on x86, no cross-compile needed.
# Elevon layout: CH1=left elevon, CH2=right elevon, CH3=throttle.
#
# ArduPlane outputs pre-mixed elevon PWM on CH1/CH2 (SERVO_FUNCTION 77/78).
# xplane_elevon.json maps both channels directly to wing surface datarefs —
# no further demix needed; override_control_surfaces prevents X-Plane
# from recomputing surfaces from yoke.
#
#   CH1 (ElevonLeft)  → wing1l_ail1def
#   CH2 (ElevonRight) → wing1r_ail1def  (inverted in JSON for aileron direction)
#
# Build:  ./waf configure --board x86-hil-elevon && ./waf plane
# Run:    sim_vehicle.py -v ArduPlane --model xplane --map --console
include ../sitl/hwdef.dat

define XPLANE_JSON "xplane_elevon.json"
