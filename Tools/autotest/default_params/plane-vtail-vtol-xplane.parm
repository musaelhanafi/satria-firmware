# ArduPlane default params for X-Plane SITL (xplane_vtail_vtol.json)
# V-tail QuadPlane VTOL:
#   CH1=Aileron  CH2=VTail_Right  CH3=FwdThrottle  CH4=VTail_Left
#   CH5=Motor1(FR,CW)  CH6=Motor2(RL,CW)  CH7=Motor3(FL,CCW)  CH8=Motor4(RR,CCW)
# Fixed-wing PID values synced from live x86-hil-vtail MAVLink port 14560 (2026-05-23).

# --- Scheduler ---
SCHED_LOOP_RATE     50

# --- SITL: sensor backends ---
ARSPD_TYPE          100

# --- SITL: skip prearm checks ---
ARMING_SKIPCHK      -1
INS_GYR_CAL         0
INS_ACCOFFS_X       0.001
INS_ACCOFFS_Y       0.001
INS_ACCOFFS_Z       0.001
INS_ACCSCAL_X       1.001
INS_ACCSCAL_Y       1.001
INS_ACCSCAL_Z       1.001
INS_ACC2OFFS_X      0.001
INS_ACC2OFFS_Y      0.001
INS_ACC2OFFS_Z      0.001
INS_ACC2SCAL_X      1.001
INS_ACC2SCAL_Y      1.001
INS_ACC2SCAL_Z      1.001

# --- INS filters ---
INS_GYRO_FILTER     20
INS_ACCEL_FILTER    20

# --- Fixed-wing servo functions ---
SERVO1_FUNCTION     4       # Aileron
SERVO2_FUNCTION     80      # RightVTail  (→ vstab1_rud1def)
SERVO2_REVERSED     1
SERVO3_FUNCTION     70      # Forward throttle (→ engine[4])
SERVO4_FUNCTION     79      # LeftVTail   (→ vstab2_rud1def)
SERVO4_REVERSED     1

# --- Quad lift motor functions (CH5-CH8 → engine[0-3]) ---
SERVO5_FUNCTION     33      # Motor1  front-right  CW
SERVO6_FUNCTION     34      # Motor2  rear-left    CW
SERVO7_FUNCTION     35      # Motor3  front-left   CCW
SERVO8_FUNCTION     36      # Motor4  rear-right   CCW

# --- QuadPlane enable and frame ---
Q_ENABLE            1
Q_FRAME_CLASS       1       # Quad
Q_FRAME_TYPE        3       # H-frame

# --- V-tail mixer gain ---
MIXING_GAIN         1.0

# --- QuadPlane rate controllers ---
Q_A_RAT_RLL_P       0.070
Q_A_RAT_RLL_I       0.070
Q_A_RAT_RLL_D       0.0018
Q_A_RAT_PIT_P       0.070
Q_A_RAT_PIT_I       0.070
Q_A_RAT_PIT_D       0.0018
Q_A_RAT_YAW_P       0.090
Q_A_RAT_YAW_I       0.009
Q_A_RAT_YAW_D       0.000
Q_A_ANG_RLL_P       4.5
Q_A_ANG_PIT_P       4.5
Q_A_ANG_YAW_P       4.5

# --- QuadPlane transition ---
Q_TRANSITION_MS     5000
Q_VFWD_GAIN         0.08
Q_TILT_TYPE         0       # no tilt rotors

# --- Fixed-wing flight envelope ---
AIRSPEED_CRUISE     12.0
AIRSPEED_MIN         9.0
AIRSPEED_MAX        22.0
TRIM_THROTTLE       45
PTCH_LIM_MIN_DEG   -25.0
PTCH_LIM_MAX_DEG    20.0
ROLL_LIMIT_DEG      45.0

# --- Fixed-wing roll rate controller ---
RLL_RATE_P          0.08
RLL_RATE_I          0.15
RLL_RATE_D          0
RLL_RATE_FF         0.345
RLL_RATE_FLTD       12.0
RLL_RATE_IMAX       0.666
RLL2SRV_TCONST      0.5
RLL2SRV_RMAX        0

# --- Fixed-wing pitch rate controller ---
PTCH_RATE_P         0.04
PTCH_RATE_I         0.15
PTCH_RATE_D         0
PTCH_RATE_FF        0.345
PTCH_RATE_FLTD      12.0
PTCH_RATE_IMAX      0.666
PTCH2SRV_TCONST     0.5
PTCH2SRV_RMAX_UP    0
PTCH2SRV_RMAX_DN    0
PTCH2SRV_RLL        1.0

# --- Navigation ---
NAVL1_PERIOD        17.0
NAVL1_DAMPING       0.75
WP_LOITER_RAD       80.0
WP_RADIUS           50.0
KFF_RDDRMIX         0.5

# --- Flight modes ---
FLTMODE1            10
FLTMODE2            11
FLTMODE3            12
FLTMODE4             5
FLTMODE5             2
FLTMODE6             0
TRK_APP_SPD 0
TRK_CLOSE_M 1000
TRK_DBAND 0.25
TRK_MAX_DEG 30
TRK_PITCH_OFFSET 7
TRK_PTCH_D 0
TRK_PTCH_D_FF 0
TRK_PTCH_FF 0
TRK_PTCH_FLTD 20
TRK_PTCH_FLTE 4
TRK_PTCH_FLTT 0
TRK_PTCH_I 50
TRK_PTCH_IMAX 1000
TRK_PTCH_NEF 0
TRK_PTCH_NTF 0
TRK_PTCH_P 45
TRK_PTCH_PDMX 0
TRK_PTCH_SMAX 0
TRK_ROLL_D 0
TRK_ROLL_D_FF 0
TRK_ROLL_FF 0
TRK_ROLL_FLTD 20
TRK_ROLL_FLTE 0
TRK_ROLL_FLTT 0
TRK_ROLL_I 50
TRK_ROLL_IMAX 500
TRK_ROLL_NEF 0
TRK_ROLL_NTF 0
TRK_ROLL_P 50
TRK_ROLL_PDMX 0
TRK_ROLL_SMAX 0
TRK_SETTLE_S 2
TRK_TGT_ALT 744
TRK_TGT_LAT -6.89736795425415
TRK_TGT_LON 107.56655883789062
TRK_THR_D 1
TRK_THR_D_FF 0
TRK_THR_FF 0
TRK_THR_FLTD 20
TRK_THR_FLTE 0
TRK_THR_FLTT 0
TRK_THR_I 5
TRK_THR_IMAX 50
TRK_THR_NEF 0
TRK_THR_NTF 0
TRK_THR_P 5
TRK_THR_PDMX 0
TRK_THR_SMAX 0
TRK_TIMEOUT 1000
