# ArduPlane default params for X-Plane SITL (xplane_vtail.json)
# V-tail aircraft: CH1=Aileron CH2=VTail_Right CH3=Throttle CH4=VTail_Left
# ArduPlane vtail mixer pre-applied: vtail_right=(elev-rud)*GAIN  vtail_left=(elev+rud)*GAIN
# PID values synced from live x86-hil-vtail MAVLink port 14560 (2026-05-23).

# --- Scheduler ---
SCHED_LOOP_RATE     50

# --- SITL: sensor backends ---
ARSPD_TYPE          100

# --- SITL: skip prearm checks ---
ARMING_SKIPCHK      -1
INS_GYR_CAL         0
INS_ACCOFFS_X       0.001
INS_ACCOFFS_Y       0.001
INS_ACCOFFS_Z       0.001
INS_ACCSCAL_X       1.001
INS_ACCSCAL_Y       1.001
INS_ACCSCAL_Z       1.001
INS_ACC2OFFS_X      0.001
INS_ACC2OFFS_Y      0.001
INS_ACC2OFFS_Z      0.001
INS_ACC2SCAL_X      1.001
INS_ACC2SCAL_Y      1.001
INS_ACC2SCAL_Z      1.001

# --- INS filters ---
INS_GYRO_FILTER     20
INS_ACCEL_FILTER    20

# --- Servo functions ---
SERVO1_FUNCTION     4       # Aileron
SERVO2_FUNCTION     80      # RightVTail  (→ vstab1_rud1def)
SERVO2_REVERSED     1
SERVO3_FUNCTION     70      # Throttle
SERVO4_FUNCTION     79      # LeftVTail   (→ vstab2_rud1def)
SERVO4_REVERSED     1

# --- V-tail mixer gain ---
MIXING_GAIN         1.0

# --- Flight envelope ---
AIRSPEED_CRUISE     12.0
AIRSPEED_MIN         9.0
AIRSPEED_MAX        22.0
TRIM_THROTTLE       45
PTCH_LIM_MIN_DEG   -25.0
PTCH_LIM_MAX_DEG    20.0
ROLL_LIMIT_DEG      45.0

# --- Roll rate controller ---
RLL_RATE_P          0.08
RLL_RATE_I          0.15
RLL_RATE_D          0
RLL_RATE_FF         0.345
RLL_RATE_FLTD       12.0
RLL_RATE_IMAX       0.666
RLL2SRV_TCONST      0.5
RLL2SRV_RMAX        0

# --- Pitch rate controller ---
PTCH_RATE_P         0.04
PTCH_RATE_I         0.15
PTCH_RATE_D         0
PTCH_RATE_FF        0.345
PTCH_RATE_FLTD      12.0
PTCH_RATE_IMAX      0.666
PTCH2SRV_TCONST     0.5
PTCH2SRV_RMAX_UP    0
PTCH2SRV_RMAX_DN    0
PTCH2SRV_RLL        1.0

# --- Navigation ---
NAVL1_PERIOD        17.0
NAVL1_DAMPING       0.75
WP_LOITER_RAD       80.0
WP_RADIUS           50.0
KFF_RDDRMIX         0.5

# --- Flight modes ---
FLTMODE1            10
FLTMODE2            11
FLTMODE3            12
FLTMODE4             5
FLTMODE5             2
FLTMODE6             0
